<v:PageBase x:TypeArguments="vm:ISettingsPageViewModel"
            xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            x:Class="HandFootExcluded.UI.Views.SettingsPage"
            xmlns:v="using:HandFootExcluded.UI.Views"
            xmlns:vm="using:HandFootExcluded.UI.ViewModels"
            Title="Settings">
    <Border Padding="10" HorizontalOptions="Fill" VerticalOptions="Fill">
        <Grid RowDefinitions="Auto,*,Auto" ColumnSpacing="20">
            <Grid.Resources>
                <Style TargetType="Entry">
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="VerticalOptions" Value="Center" />
                    <Setter Property="HeightRequest" Value="35"></Setter>
                </Style>
                <Style TargetType="Label">
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="FontAttributes" Value="Bold" />
                    <Setter Property="VerticalOptions" Value="Center" />
                    <Setter Property="HeightRequest" Value="35"></Setter>
                </Style>
                <Style TargetType="Label" x:Key="SectionHeader">
                    <Setter Property="FontSize" Value="20" />
                    <Setter Property="FontAttributes" Value="Bold" />
                    <Setter Property="VerticalOptions" Value="End" />
                </Style>
                <Style TargetType="Entry" x:Key="NumericEntry" BasedOn="{StaticResource {x:Type Entry}}">
                    <Setter Property="Keyboard" Value="Numeric" />
                    <Setter Property="WidthRequest" Value="80" />
                    <Setter Property="HorizontalTextAlignment" Value="End"></Setter>
                </Style>
                <Style TargetType="Button">
                    <Setter Property="BackgroundColor" Value="DarkBlue" />
                    <Setter Property="TextColor" Value="White" />
                    <Setter Property="Margin" Value="4,0" />
                    <Setter Property="WidthRequest" Value="90" />
                </Style>
                <Style TargetType="RadioButton">
                    <Setter Property="HorizontalOptions" Value="Start" />
                    <Setter Property="VerticalOptions" Value="Center" />
                </Style>
            </Grid.Resources>

            <!-- Content row -->
            <Grid Grid.Row="1" ColumnDefinitions="45*,25*,30*" ColumnSpacing="5" VerticalOptions="Start">

                <!-- Players -->
                <Grid Grid.Column="0"
                      RowDefinitions="30,Auto,Auto,Auto,Auto,Auto"
                      ColumnDefinitions="Auto,*,Auto"
                      RowSpacing="1" ColumnSpacing="2">
                    <Label Grid.Row="0" Grid.ColumnSpan="2" Text="Players" Style="{StaticResource SectionHeader}" />
                    <Label Grid.Row="0" Grid.Column="2" Text="Exclude." FontSize="12" VerticalOptions="Center"  />

                    <Label Grid.Row="1" Text="1:" />
                    <Entry Grid.Row="1" Grid.Column="1" Placeholder="Player 1"
                           Text="{Binding DefaultPlayer1, Mode=TwoWay}"/>
                    <RadioButton Grid.Row="1" Grid.Column="2" GroupName="excludedGroup"
                                 IsChecked="{Binding ExcludedPlayer1, Mode=TwoWay}" />

                    <Label Grid.Row="2" Text="2:" />
                    <Entry Grid.Row="2" Grid.Column="1" Placeholder="Player 2"
                           Text="{Binding DefaultPlayer2, Mode=TwoWay}" />
                    <RadioButton Grid.Row="2" Grid.Column="2" GroupName="excludedGroup"
                                 IsChecked="{Binding ExcludedPlayer2, Mode=TwoWay}" />

                    <Label Grid.Row="3" Text="3:" />
                    <Entry Grid.Row="3" Grid.Column="1" Placeholder="Player 3"
                           Text="{Binding DefaultPlayer3, Mode=TwoWay}" />
                    <RadioButton Grid.Row="3" Grid.Column="2" GroupName="excludedGroup"
                                 IsChecked="{Binding ExcludedPlayer3, Mode=TwoWay}" />

                    <Label Grid.Row="4" Text="4:" />
                    <Entry Grid.Row="4" Grid.Column="1" Placeholder="Player 4"
                           Text="{Binding DefaultPlayer4, Mode=TwoWay}" />
                    <RadioButton Grid.Row="4" Grid.Column="2" GroupName="excludedGroup"
                                 IsChecked="{Binding ExcludedPlayer4, Mode=TwoWay}" />

                    <Label Grid.Row="5" Text="5:" />
                    <Entry Grid.Row="5" Grid.Column="1" Placeholder="Player 5"
                           Text="{Binding DefaultPlayer5, Mode=TwoWay}" />
                    <RadioButton Grid.Row="5" Grid.Column="2" GroupName="excludedGroup"
                                 IsChecked="{Binding ExcludedPlayer5, Mode=TwoWay}" />
                </Grid>

                <!-- Rounds -->
                <Grid Grid.Column="1"
                      RowDefinitions="30,Auto,Auto,Auto,Auto,Auto"
                      ColumnDefinitions="Auto,*"
                      RowSpacing="1" ColumnSpacing="2">
                    <Label Grid.ColumnSpan="2" Text="Rounds" Style="{StaticResource SectionHeader}" />

                    <Label Grid.Row="1" Text="1:" />
                    <Entry Grid.Row="1" Grid.Column="1" Style="{StaticResource NumericEntry}"
                           Placeholder="Opening 1" Text="{Binding RoundOpening1, Mode=TwoWay}" />

                    <Label Grid.Row="2" Text="2:" />
                    <Entry Grid.Row="2" Grid.Column="1" Style="{StaticResource NumericEntry}"
                           Placeholder="Opening 2" Text="{Binding RoundOpening2, Mode=TwoWay}" />

                    <Label Grid.Row="3" Text="3:" />
                    <Entry Grid.Row="3" Grid.Column="1" Style="{StaticResource NumericEntry}"
                           Placeholder="Opening 3" Text="{Binding RoundOpening3, Mode=TwoWay}" />

                    <Label Grid.Row="4" Text="4:" />
                    <Entry Grid.Row="4" Grid.Column="1" Style="{StaticResource NumericEntry}"
                           Placeholder="Opening 4" Text="{Binding RoundOpening4, Mode=TwoWay}" />

                    <Label Grid.Row="5" Text="5:" />
                    <Entry Grid.Row="5" Grid.Column="1" Style="{StaticResource NumericEntry}"
                           Placeholder="Opening 5" Text="{Binding RoundOpening5, Mode=TwoWay}" />
                </Grid>

                <!-- Rules -->
                <Grid Grid.Column="2"
                      RowDefinitions="30,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                      ColumnDefinitions="Auto,*"
                      RowSpacing="1" ColumnSpacing="2">
                    <Label Grid.ColumnSpan="2" Text="Rules" Style="{StaticResource SectionHeader}" />

                    <Label Grid.Row="1" Text="Bonus Amount 1:" />
                    <Entry Grid.Row="1" Grid.Column="1" Style="{StaticResource NumericEntry}"
                           Text="{Binding IndividualBonusAmount1, Mode=TwoWay}" />

                    <Label Grid.Row="2" Text="Bonus Amount 2:" />
                    <Entry Grid.Row="2" Grid.Column="1" Style="{StaticResource NumericEntry}"
                           Text="{Binding IndividualBonusAmount2, Mode=TwoWay}" />

                    <Label Grid.Row="3" Text="Bonus Amount 3:" />
                    <Entry Grid.Row="3" Grid.Column="1" Style="{StaticResource NumericEntry}"
                           Text="{Binding IndividualBonusAmount3, Mode=TwoWay}" />

                    <Label Grid.Row="4" Text="Bonus Amount 4:" />
                    <Entry Grid.Row="4" Grid.Column="1" Style="{StaticResource NumericEntry}"
                           Text="{Binding IndividualBonusAmount4, Mode=TwoWay}" />

                    <Label Grid.Row="5" Text="Team Bonus:" />
                    <Entry Grid.Row="5" Grid.Column="1" Style="{StaticResource NumericEntry}"
                           Text="{Binding TeamBonusAmount, Mode=TwoWay}" />

                    <Label Grid.Row="6" Text="Min Discard Pickup:" />
                    <Entry Grid.Row="6" Grid.Column="1" Style="{StaticResource NumericEntry}"
                           Text="{Binding MinDiscardPickup, Mode=TwoWay}" />

                    <Label Grid.Row="7" Text="Max Discard Pickup:" />
                    <Entry Grid.Row="7" Grid.Column="1" Style="{StaticResource NumericEntry}"
                           Text="{Binding MaxDiscardPickup, Mode=TwoWay}" />
                </Grid>
            </Grid>

            <!-- Buttons -->
            <HorizontalStackLayout Grid.Row="2" HorizontalOptions="Start" >
                <Button Text="Load" Command="{Binding LoadCommand}" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Grid.Row="2" HorizontalOptions="End" >
                <Button Text="Ok" Command="{Binding OkCommand}" />
                <Button Text="Close" Command="{Binding CloseCommand}" />
            </HorizontalStackLayout>
        </Grid>
    </Border>
</v:PageBase>