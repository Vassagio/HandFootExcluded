<?xml version="1.0" encoding="utf-8"?>
<v:PageBase x:TypeArguments="vm:ISummaryPageViewModel"
            xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            x:Class="HandFootExcluded.UI.Views.SummaryPage"
            xmlns:v="using:HandFootExcluded.UI.Views"
            xmlns:vm="using:HandFootExcluded.UI.ViewModels"
            xmlns:dg="clr-namespace:Maui.DataGrid;assembly=Maui.DataGrid"
            Title="Summary">

    <ContentPage.Resources>
        <Style TargetType="Label" x:Key="DataLabel">
            <Setter Property="VerticalOptions" Value="Fill" />
            <Setter Property="HorizontalOptions" Value="Fill" />
            <Setter Property="VerticalTextAlignment" Value="Center" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="FontSize" Value="{Binding FontSize}" />
            <Setter Property="TextColor" Value="#1A2440" />
            <Style.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding IsBold}" Value="True">
                    <Setter Property="FontAttributes" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Label" x:Key="DescriptionLabel" BasedOn="{StaticResource DataLabel}">
            <Setter Property="HorizontalTextAlignment" Value="Start" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style TargetType="Label" x:Key="GridHeaderLabel">
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="VerticalTextAlignment" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto" RowSpacing="3"
          Padding="1" BackgroundColor="#0F1B3D">

        <!-- Grid wrapped in a rounded card -->
        <Border Grid.Row="0"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 14"
                BackgroundColor="White">
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.4" Radius="10" Offset="0,4" />
            </Border.Shadow>

            <dg:DataGrid ItemsSource="{Binding SummaryLines}"
                         SelectionEnabled="False"
                         RowHeight="34"
                         HeaderHeight="40"
                         HeaderBackground="#1E2F5C"
                         HeaderLabelStyle="{StaticResource GridHeaderLabel}"
                         BorderColor="#E3E7F2"
                         BorderThickness="1"
                         HorizontalOptions="Fill" VerticalOptions="Fill">
                <dg:DataGrid.Columns>
                    <dg:DataGridColumn Title="" HorizontalContentAlignment="Start">
                        <dg:DataGridColumn.CellTemplate>
                            <DataTemplate>
                                <Label Text="{Binding Description}"
                                       Style="{StaticResource DescriptionLabel}" />
                            </DataTemplate>
                        </dg:DataGridColumn.CellTemplate>
                    </dg:DataGridColumn>
                    <dg:DataGridColumn Title="{Binding Player1Name}">
                        <dg:DataGridColumn.CellTemplate>
                            <DataTemplate>
                                <Label Text="{Binding Player1Score}" Style="{StaticResource DataLabel}" />
                            </DataTemplate>
                        </dg:DataGridColumn.CellTemplate>
                    </dg:DataGridColumn>
                    <dg:DataGridColumn Title="{Binding Player2Name}">
                        <dg:DataGridColumn.CellTemplate>
                            <DataTemplate>
                                <Label Text="{Binding Player2Score}" Style="{StaticResource DataLabel}" />
                            </DataTemplate>
                        </dg:DataGridColumn.CellTemplate>
                    </dg:DataGridColumn>
                    <dg:DataGridColumn Title="{Binding Player3Name}">
                        <dg:DataGridColumn.CellTemplate>
                            <DataTemplate>
                                <Label Text="{Binding Player3Score}" Style="{StaticResource DataLabel}" />
                            </DataTemplate>
                        </dg:DataGridColumn.CellTemplate>
                    </dg:DataGridColumn>
                    <dg:DataGridColumn Title="{Binding Player4Name}">
                        <dg:DataGridColumn.CellTemplate>
                            <DataTemplate>
                                <Label Text="{Binding Player4Score}" Style="{StaticResource DataLabel}" />
                            </DataTemplate>
                        </dg:DataGridColumn.CellTemplate>
                    </dg:DataGridColumn>
                    <dg:DataGridColumn Title="{Binding Player5Name}">
                        <dg:DataGridColumn.CellTemplate>
                            <DataTemplate>
                                <Label Text="{Binding Player5Score}" Style="{StaticResource DataLabel}" />
                            </DataTemplate>
                        </dg:DataGridColumn.CellTemplate>
                    </dg:DataGridColumn>
                </dg:DataGrid.Columns>

                <dg:DataGrid.RowsBackgroundColorPalette>
                    <dg:PaletteCollection>
                        <Color>#F4F6FB</Color>
                        <Color>#FFFFFF</Color>
                    </dg:PaletteCollection>
                </dg:DataGrid.RowsBackgroundColorPalette>
            </dg:DataGrid>
        </Border>

        <!-- Close button -->
        <Button Grid.Row="1" Text="Close"
                Command="{Binding CloseCommand}"
                BackgroundColor="#F5C518" TextColor="#0F1B3D"
                FontAttributes="Bold"
                CornerRadius="12"
                WidthRequest="160" HeightRequest="44"
                HorizontalOptions="Center" />
    </Grid>
</v:PageBase>