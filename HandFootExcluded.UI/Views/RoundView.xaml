<?xml version="1.0" encoding="utf-8"?>

<v:ViewBase x:TypeArguments="vm:IRoundViewModel"
            xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:v="using:HandFootExcluded.UI.Views"
            xmlns:vm="using:HandFootExcluded.UI.ViewModels"
            x:Class="HandFootExcluded.UI.Views.RoundView">
    <Grid VerticalOptions="Fill" HorizontalOptions="Fill">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Grid.Column="0" BackgroundColor="DarkBlue" HorizontalOptions="Fill" VerticalOptions="Fill">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"></RowDefinition>
            </Grid.RowDefinitions>

            <Label x:Name="roundLabel" Grid.Column="0" MaximumHeightRequest="50" Text="{Binding Order, StringFormat='Round {0}'}" TextColor="White" HorizontalOptions="Fill" VerticalOptions="Center" VerticalTextAlignment="Center" FontSize="28" FontAttributes="Bold" HorizontalTextAlignment="Center" Margin="0,0,0,10"/>
            <HorizontalStackLayout Grid.Column="2" BackgroundColor="DarkBlue" HorizontalOptions="End" VerticalOptions="Fill">
                <Label Margin="3,0" Text="Open:" FontAttributes="Bold" TextColor="Yellow" HorizontalOptions="Fill" VerticalOptions="Fill" FontSize="14" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                <Label Margin="0,0,10,0" Text="{Binding OpenAmount}" TextColor="Yellow" HorizontalOptions="Fill" VerticalOptions="Fill" FontSize="14" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
            </HorizontalStackLayout>
        </Grid>

        <v:TeamView Grid.Row="1" BindingContext="{Binding StartingTeam}" BackgroundColor="#60C71585" />
        <v:TeamView Grid.Row="2" BindingContext="{Binding OpposingTeam}" BackgroundColor="#6034E2E2" />

        <HorizontalStackLayout Grid.Row="3" HorizontalOptions="Fill" VerticalOptions="Fill" BackgroundColor="MediumVioletRed">
            <Label Margin="3,0" Text="Excluded Player:" HorizontalTextAlignment="Start" VerticalTextAlignment="Center" FontAttributes="Bold" FontSize="20" />
            <Label Margin="3,0" Text="{Binding ExcludedPlayerInitials}" HorizontalTextAlignment="Start" VerticalTextAlignment="Center" FontAttributes="Bold" FontSize="20" />
        </HorizontalStackLayout>
    </Grid>
</v:ViewBase>