<?xml version="1.0" encoding="utf-8"?>
<v:ViewBase x:TypeArguments="vm:ITotalScoreViewModel"
            xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:v="using:HandFootExcluded.UI.Views"
            xmlns:vm="using:HandFootExcluded.UI.ViewModels"
            x:Class="HandFootExcluded.UI.Views.TotalScoreView">

    <Border StrokeThickness="0" Margin="8,0,8,5"
            StrokeShape="RoundRectangle 16">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#1E2F5C" Offset="0" />
                <GradientStop Color="#0F1B3D" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Shadow>
            <Shadow Brush="Black" Opacity="0.4" Radius="10" Offset="0,4" />
        </Border.Shadow>

        <Grid RowDefinitions="Auto,Auto,*" Padding="12,10">

            <Button Grid.Row="0" Text="Scores" FontSize="20" FontAttributes="Bold"
                    Command="{Binding SummaryCommand}" Margin="0,0,0,5"/>

            <!-- Score lines: no ListView, no scrolling -->
            <FlexLayout Grid.Row="2"
                        Direction="Column"
                        JustifyContent="SpaceEvenly"
                        BindableLayout.ItemsSource="{Binding ScoreLines}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="Auto,*"
                              FlexLayout.Grow="1">
                            <Label Grid.Column="0"
                                   Text="{Binding Initials, StringFormat='{0}:'}"
                                   TextColor="#9FB3E8" FontSize="15"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding Value}"
                                   TextColor="White" FontSize="16" FontAttributes="Bold"
                                   HorizontalTextAlignment="End"
                                   VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
        </Grid>
    </Border>
</v:ViewBase>