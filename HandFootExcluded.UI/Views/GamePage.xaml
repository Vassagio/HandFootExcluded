<?xml version="1.0" encoding="utf-8"?>
<v:PageBase x:TypeArguments="vm:IGamePageViewModel"
            xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            x:Class="HandFootExcluded.UI.Views.GamePage"
            xmlns:v="using:HandFootExcluded.UI.Views"
            xmlns:vm="using:HandFootExcluded.UI.ViewModels"
            Title="Game">

    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="0"
          Padding="4" BackgroundColor="#0F1B3D">

        <Grid.Resources>
            <!-- Bordered action button, matches the Open pill styling -->
            <Style TargetType="Button">
                <Setter Property="BackgroundColor" Value="#1E2F5C" />
                <Setter Property="BorderColor" Value="#3A4E80" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="14,8" />
            </Style>
        </Grid.Resources>

        <!-- Left rail: close, running scores, summary -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" RowSpacing="1">

            <Button Grid.Row="0" Text="✕"
                    Command="{Binding CloseCommand}"
                    HorizontalOptions="Start"
                    FontSize="16"
                    BackgroundColor="Transparent"
                    BorderWidth="0"
                    Padding="2,0"
                    SemanticProperties.Hint="Close the game" />

            <v:TotalScoreView Grid.Row="1"
                              BindingContext="{Binding TotalScore}"
                              WidthRequest="150" />

  
        </Grid>

        <!-- Main area: round + bottom action bar -->
        <Grid Grid.Column="1" RowDefinitions="*,Auto" RowSpacing="5">

            <v:RoundView Grid.Row="0" BindingContext="{Binding CurrentRound}" />

            <!-- Bottom action bar -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="5" >
                <Button Grid.Column="0" Text="Discard Pickup"
                        Command="{Binding DiscardPickupCommand}" />

                <Button Grid.Column="2" Text="◀ Previous"
                        Command="{Binding PreviousCommand}" />
                <Button Grid.Column="3" Text="Next ▶"
                        Command="{Binding NextCommand}"
                        BackgroundColor="#F5C518"
                        TextColor="#0F1B3D"
                        FontAttributes="Bold"
                        BorderWidth="0" />
            </Grid>
        </Grid>
    </Grid>
</v:PageBase>